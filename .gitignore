.env
logs/*
# 執行期資料依生命週期分層（開頭的斜線只錨定根目錄，不會連 src/scraper/data 一起忽略）：
# data/ 不能重建、要備份（pgvector、hermes）；cache/ 可重建的衍生資料（search-mcp 的索引）；run/ 執行期暫存（GPU 鎖檔）
/data/
/cache/
/run/
__pycache__/
src/music/cache/
monitored_channels.json
src/scraper/data/*.json
src/scraper/articles.db
src/scraper/articles.db-shm
src/scraper/articles.db-wal
src/scraper/articles_bk*.db
src/services/sent_articles.json
src/services/sent_articles_bk.json
staged_diff.txt
doc/

# Telethon session（避免把登入憑證提交到版本庫）
src/telegram_scraper/session/
src/telegram_scraper/media/
src/services/sent_articles.db
src/services/sent_articles.db-shm
src/services/sent_articles.db-wal
# bot 執行時寫的資料（透過 Discord 設的值＋它自己的紀錄：面板、點名、音樂、價格表、關鍵字監控）：整個資料夾不進版控
src/settings/runtime/
src/services/search/eval/private/
