# Discord 機器人令牌設置
# 請替換為您的實際 Discord 機器人令牌
# 您可以從 Discord Developer Portal 獲取令牌: https://discord.com/developers/applications
# 注意：令牌應該是一個長字串，如：NzkyNzE1NDU0MTk2MDg4ODQy.X-hvzA.Ovy4MCQywSkoMRRclStW4xAYK7I (這只是一個示例)
# 修改此文件後，容器將在60秒內自動嘗試重新連接
DISCORD_TOKEN=type_your_discord_token_here

# 可選配置
# 日誌級別 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 管理命令擁有者ID
# 請替換為您的 Discord 使用者ID，只有此ID的使用者才能使用管理命令
OWNER_ID=type_your_discord_user_id_here

# ===== Ollama / LLM =====
# Ollama API 位置（可填主機 IP 或網域）
OLLAMA_BASE_URL=http://192.168.56.1:11434
# 逾時秒數
OLLAMA_TIMEOUT=180

# ===== PGVector / PostgreSQL =====
# 若未填主機與連接埠，程式內會使用預設 pgvector:5432
PGVECTOR_DB=discord_data
PGVECTOR_USER=llm_vector
# 請務必改成強密碼
PGVECTOR_PASSWORD=change_me_to_a_strong_password
