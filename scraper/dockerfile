# 使用 Python 作為基礎映像
FROM python:3.12-slim

# 設定工作目錄
WORKDIR /app

# 安裝 Firefox 必要的依賴（精簡版，主要保留圖形支援和中文字型）
RUN apt-get update && apt-get install -y \
    wget \
    # 圖形介面支援（Firefox 無頭模式需要）
    libgtk-3-0 \
    libdbus-1-3 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    xdg-utils \
    xvfb \
    # 中文字型（Facebook 使用中文）
    fonts-liberation \
    fonts-arphic-ukai \
    fonts-arphic-uming \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    && rm -rf /var/lib/apt/lists/*

# 安裝 Firefox
RUN apt-get update && apt-get install -y \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# 安裝 GeckoDriver (Firefox 的 Selenium 驅動)
RUN wget -q https://github.com/mozilla/geckodriver/releases/download/v0.36.0/geckodriver-v0.36.0-linux64.tar.gz \
    && tar -xzf geckodriver-v0.36.0-linux64.tar.gz \
    && mv geckodriver /usr/local/bin/ \
    && chmod +x /usr/local/bin/geckodriver \
    && rm geckodriver-v0.36.0-linux64.tar.gz

# 建立應用程式使用者
RUN groupadd -r appuser && useradd -r -g appuser -m -d /home/appuser -u 1000 appuser
RUN chown -R appuser:appuser /app
RUN chown -R appuser:appuser /home/appuser

# 建立資料和日誌目錄並設定權限
RUN mkdir -p /app/data /logs && chown -R appuser:appuser /app/data /logs

# 切換到非 root 使用者
USER appuser

# 複製依賴檔案並安裝
COPY scraper/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# 程式碼透過 volume 掛載，環境變數透過 docker-compose 設定
# 使用新的主程式啟動
CMD ["python", "main.py"]
